# ─────────────────────────────────────────────────────────────────────────────
# Antigravity Consumption Dashboard — Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to config.env and fill in the values below.
#
#   cp config.env.example config.env
#   nano config.env          # or use any text editor
#   bash deploy.sh
#
# Lines starting with # are comments. Only uncomment lines you want to change.
# ─────────────────────────────────────────────────────────────────────────────

# ┌─────────────────────────────────────────────────────────────────────────┐
# │  REQUIRED — You must set these before running deploy.sh                │
# └─────────────────────────────────────────────────────────────────────────┘

# Your Google Cloud Project ID.
# Find it at: https://console.cloud.google.com/home/dashboard
PROJECT_ID="your-project-id"

# Email addresses allowed to access the dashboard.
# Separate multiple emails with spaces. Supports users and groups.
# Examples:
#   "user:admin@company.com"
#   "user:jane@gmail.com"
#   "group:engineering@company.com"
AUTHORIZED_MEMBERS=(
  "user:admin@example.com"
)

# ┌─────────────────────────────────────────────────────────────────────────┐
# │  OPTIONAL — Sensible defaults are provided                            │
# └─────────────────────────────────────────────────────────────────────────┘

# GCP region for Cloud Run, Artifact Registry, and other regional resources.
# See: https://cloud.google.com/run/docs/locations
# REGION="us-central1"

# BigQuery dataset location. This is where your usage data is stored.
# Use a multi-region for best availability: "US" or "EU"
# Or a single region: "us-central1", "europe-west1", "asia-southeast1", etc.
# ⚠️  Cannot be changed after creation. Choose carefully.
# DATASET_LOCATION="US"

# BigQuery dataset ID. Almost never needs changing.
# DATASET_ID="agy_consumption"

# Custom domain for the dashboard (e.g., "dashboard.acme.com").
# If set:  → Google-managed SSL cert (trusted by browsers, auto-renews)
#            You must create a DNS A record pointing this domain to the
#            static IP printed by deploy.sh.
# If empty: → Self-signed SSL cert (works with raw IP, browser shows warning)
# DOMAIN=""

# Gemini models to enable request-response logging for.
# These are all the GA Gemini model families usable with Antigravity.
# Remove models you don't use to reduce unnecessary API calls.
GEMINI_MODELS=(
  # ── Gemini 3.5 (Latest frontier) ──
  "gemini-3.5-flash"

  # ── Gemini 3.1 ──
  "gemini-3.1-flash-lite"

  # ── Gemini 2.5 (Proven / stable) ──
  "gemini-2.5-pro"
  "gemini-2.5-flash"
  "gemini-2.5-flash-lite"
)

# ┌─────────────────────────────────────────────────────────────────────────┐
# │  IAP OAuth Credentials — filled in AFTER first deploy                  │
# └─────────────────────────────────────────────────────────────────────────┘
# The deploy script will print step-by-step instructions for creating these.
# Leave empty on your first run. Fill in after creating the OAuth client
# in GCP Console, then re-run deploy.sh.
#
# Detailed guide: docs/deployment-guide.md (Step 6)

IAP_CLIENT_ID=""
IAP_CLIENT_SECRET=""
